# Copy this file to .env and paste your keys after the = signs.
# All optional. The dashboard works without them.
ABUSEIPDB_API_KEY=
IPQS_API_KEY=
# Free from https://api.data.gov/signup - lets the FTC connector pull more scam call reports
DATA_GOV_API_KEY=
# Free from https://www.ransomware.live/my - needed while the no-key API is down
RANSOMWARE_LIVE_API_KEY=
